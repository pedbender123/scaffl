# ══════════════════════════════════════════════════════════════════════════════
# Scaffl — Environment Variables
# Copy this file to .env and fill in the values.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ══════════════════════════════════════════════════════════════════════════════

# ── Deployment mode ────────────────────────────────────────────────────────────
# selfhosted (default): single-instance, no billing, BYOK.
# cloud: multi-tenant Scaffl SaaS deployment (internal).
DEPLOYMENT_MODE=selfhosted

# ── Required secrets ──────────────────────────────────────────────────────────
# Must be ≥ 32 characters. Server refuses to start without this.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# AES-256-GCM master key for encrypting provider API keys stored in the DB.
# Required if you plan to manage keys via the Admin UI (recommended).
# Must be exactly 32 bytes encoded as base64 (44-character string).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SCAFFL_MASTER_KEY=

# ── Super admin account ────────────────────────────────────────────────────────
# On first run, if these are set, the admin account is created / updated automatically.
SUPER_ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-run

# ── AI Provider keys (env-based BYOK fallback) ───────────────────────────────
# You can also set these via Admin → Inteligência Artificial (stored encrypted in the DB).
# If both are set, the DB credential takes priority.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=   # optional: custom base URL for OpenAI-compatible endpoints

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# DATABASE_PATH=./server/scaffl.db   # default: <server dir>/tutorai.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to allow all (dev default).
# ALLOWED_ORIGINS=https://your-domain.com

# ── Optional features ─────────────────────────────────────────────────────────
# WhatsApp contact tool: if set, the AI chat exposes a "contact professor" tool
# that generates a wa.me link. Format: international number without +
# Example: 5511999999999 (Brazil)
# PROFESSOR_WHATSAPP=

# ── Cloud billing telemetry (cloud deployments only) ─────────────────────────
# These are used only by the /api/admin/ia-usage dashboard.
# In self-hosted mode, leave these at 0.
# SCAFFL_SPEND_CAP=0          # monthly budget ceiling in BRL (0 = display only)
# SCAFFL_EXTERNAL_SPEND=0     # historical spend accrued outside this instance
